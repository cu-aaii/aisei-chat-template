# These three are the only environment variables this app reads. Everything else about
# the chat feature — gateway base URL, model, rate limits, tool labels — is non-secret
# configuration and lives as a constant in server/app.config.ts, so there's nothing here
# that can silently disagree with production.

# 4318 locally; the Dockerfile bakes 8000 for the container.
PORT=4318

# Cornell LiteLLM gateway key for the site chat assistant (server/modules/chat/).
# Leave blank to run the stub chat router instead — the widget still renders and responds,
# it just says the feature isn't configured yet, so local dev never crashes without it.
# Get a key from https://ai.it.cornell.edu (Cornell AI Platform / LiteLLM gateway).
# NEVER commit a real key — .env is git-ignored; this example file is not.
GATEWAY_API_KEY=

# Kill switch for the site chat assistant — set to `false` to pull the feature entirely
# (floating widget and /api/chat) without touching the key above.
# Defaults to enabled. Kept as an env var rather than a constant so chat can be disabled in
# production with a config change instead of a rebuild.
CHAT_ENABLED=true
