{
  "name": "aisei-chat-template",
  "version": "0.1.0",
  "description": "Starter Angular + Hono site with a built-in AI chat assistant (Cornell AI Innovation Hub theme)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "tsx scripts/export-chat-content.mjs",
    "dev": "concurrently --kill-others \"npm run server:dev\" \"ng serve --proxy-config proxy.conf.json --port 4200\"",
    "server:dev": "tsx watch --env-file=.env server/index.ts",
    "build": "ng build --configuration production --output-path=dist/client && tsc -p server/tsconfig.json && tsx scripts/export-chat-content.mjs && tsx scripts/generate-sitemap.mjs",
    "start": "node --env-file=.env dist/server/index.js",
    "run:local": "npm run build && node --env-file=.env dist/server/index.js",
    "check": "tsc -p server/tsconfig.json --noEmit && tsc -p evals/tsconfig.json && vitest run --config evals/vitest.config.ts evals/chat-cases.test.ts evals/transcript-log.test.ts evals/prompt-cache.test.ts && ng build --configuration production",
    "lint": "ng lint",
    "test:chat": "vitest run --config evals/vitest.config.ts",
    "test:chat:draft": "tsx --env-file=.env evals/draft-chat-cases.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@hono/node-server": "^2.1.6",
    "ai": "^6.0.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.17",
    "marked": "^18.0.5",
    "turndown": "^7.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/ssr": "22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.4",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.6.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12",
    "zone.js": "^0.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cu-aaii/aisei-chat-template.git"
  }
}
