{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022"
  },
  "files": ["main.ts", "main.server.ts"],
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": [
    "../server/**/*",
    "../node_modules/**/*",
    "../dist/**/*"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
